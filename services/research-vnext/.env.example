# research-vnext (8300) · 环境变量模板
# ---------------------------------------------------------------------------
# 复制为 `.env` 后填入真实值。`.env` 已被仓库根 .gitignore 忽略（第 46 行），
# **绝对不得**把真实密钥写进本文件或提交进仓库。
# ---------------------------------------------------------------------------

# PostgreSQL 事实权威（Research Core 的表在这里）
# 形状：postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# 本机 dev：math-arena-postgres 容器，宿主端口 54329
RESEARCH_DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:54329/research_vnext

# 生产 schema = rv8300（P00 registry 固化前缀；见 docs/ADR-RV-001-schema-and-runtime.md）
# 隔离测试通过显式覆盖本变量实现（rv8300_it_* / rv8300_e2e / rv8300_trace），
# 因此本变量**必须**保持可覆盖，不要改成 public。
# schema 由迁移幂等自建（CREATE SCHEMA IF NOT EXISTS），全新库无需手工建 schema。
RESEARCH_DB_SCHEMA=rv8300

# prod = 生产语义：启动只校验 schema 存在，缺失即退出（不做 runtime DDL）
# test = 仅测试用，允许 ensure_schema() 建表
RESEARCH_ENV=prod

# 网关签名密钥（HMAC-SHA256，用于校验网关注入的 AccessContext）。
# 空值 = fail closed（所有请求 401）。生成方式示例（不要提交生成结果）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RESEARCH_GATEWAY_HMAC_SECRET=<generate-a-random-local-secret>

# SSE 参数
RESEARCH_SSE_HEARTBEAT_SECONDS=15
RESEARCH_SSE_RETENTION_EVENTS=1000
RESEARCH_SSE_RETENTION_HOURS=24

# 同时挂载的 REST/SSE 前缀（逗号分隔）。默认两个都要：
#   /api/research-v1      = P00 既有契约
#   /api/research-vnext   = 前端 researchApi.ts 实际调用
# 留空即使用上述默认值。灰度/回退时可只保留一个。
RESEARCH_API_PREFIXES=/api/research-v1,/api/research-vnext

# ---------------------------------------------------------------------------
# RV06 · FoundationalMath 只读 adapter 的 Teacher direct-chunk DSN
# 形如：postgresql+psycopg://<readonly-user>:<readonly-password>@localhost:54330/teacher_platform
# 只读：adapter 以 default_transaction_read_only=on 连接，写操作会被 PostgreSQL 拒绝。
# 生产建议使用**专用只读账号**，不要复用 teacher 应用账号。
# 未配置时教材维度 fail closed（该 provider 记 PARTIAL），不会静默返回空结果。
RESEARCH_FOUNDATIONAL_DATABASE_URL=postgresql+psycopg://<readonly-user>:<readonly-password>@localhost:54330/teacher_platform

# ---------------------------------------------------------------------------
# RV-XF · 讯飞星辰线上工作流（论文工作台功能内核）
# 铁律：真实密钥只在本机 `.env`（gitignored）与环境变量；本文件只放占位符。
# ---------------------------------------------------------------------------
RESEARCH_XF_ENABLED=false
RESEARCH_XF_BASE_URL=https://xingchen-api.xf-yun.com
RESEARCH_XF_APP_ID=<your-app-id>
RESEARCH_XF_API_KEY=<your-api-key>
RESEARCH_XF_API_SECRET=<your-api-secret>
RESEARCH_XF_TIMEOUT_SECONDS=120
RESEARCH_XF_MAX_CONCURRENCY=3
RESEARCH_XF_FLOW_LATEX_EDITING=<flow-id>
RESEARCH_XF_FLOW_METHOD_RAG=<flow-id>
RESEARCH_XF_FLOW_WRITING_POLISH=<flow-id>
RESEARCH_XF_FLOW_ACADEMIC_TRANSLATE=<flow-id>

# ---------------------------------------------------------------------------
# LiteLLM 冷启动陷阱（运维必读）
# litellm 首次调用会**同步**拉取远端 model cost map（raw.githubusercontent.com）。
# 网络受限时该请求挂到超时，期间阻塞事件循环 → 表现为"服务全端点超时/500"。
# 生产/受限网络环境请置 true，直接用本地内置表。
# ---------------------------------------------------------------------------
LITELLM_LOCAL_MODEL_COST_MAP=True

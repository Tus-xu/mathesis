# RV14 tex-worker 编译镜像 · 服务器侧构建变体（r7-deploy 阶段一）
#
# 与同目录 Dockerfile 的差异：原版基镜像按 image ID 钉死
# （math-arena-base:py312-slim-pinned，该 tag 只存在于开发机本地，
#  服务器上拉不到），服务器变体直接用 python:3.12-slim + 阿里云 apt 镜像。
# TeX 包集与原版一致：xelatex + ctex 中文（Fandol 字体，fontset=fandol）+ poppler QA 工具。
#
# 服务器构建：
#   docker build -f Dockerfile.server -t math-arena-tex:0.1.0 .
FROM python:3.12-slim

ARG APT_MIRROR=mirrors.aliyun.com

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi; \
    apt-get update \
 && apt-get install -y --no-install-recommends \
      texlive-xetex \
      texlive-lang-chinese \
      texlive-fonts-recommended \
      texlive-latex-recommended \
      texlive-latex-extra \
      poppler-utils \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /work && chown 65534:65534 /work
WORKDIR /work
USER 65534:65534
ENV HOME=/tmp

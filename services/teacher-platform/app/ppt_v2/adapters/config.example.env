# ===== PPT Studio V2 Adapter 环境变量样例（占位符，禁止真实值） =====
# R11 前置：真实 key 必须在供应商后台撤销/轮换并经打码核验后才可使用。
# 只从进程环境读取下列变量名；真实 key 禁止进入代码、日志、fixture、commit。
# 本文件是占位符模板，可提交；真实密钥只进 .env（gitignore）。

MODEL_API_KEY=sk-placeholder-xxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_API_KEY=sk-placeholder-xxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_API_KEY=sk-placeholder-xxxxxxxxxxxxxxxxxxxxxxxxxxx
SEARCH_API_KEY=sk-placeholder-xxxxxxxxxxxxxxxxxxxxxxxxxxx

# embedding 通道（可选覆盖；缺省见 app/rag/embedder.py 常量）
EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
EMBEDDING_MODEL=xop3qwen8bembedding
EMBEDDING_DIMS=768

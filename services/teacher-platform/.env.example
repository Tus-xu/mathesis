# ===== 教师端 V3 平台 · 环境变量样例（占位符，真实密钥只进 .env） =====
# 02-ARCHITECTURE §15 · 密钥只进 .env（gitignore），本文件永远是占位符

# 服务
TEACHER_API_PORT=8100
TEACHER_API_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres（teacher_platform 库，容器内主机名 teacher-postgres）
DATABASE_URL=postgresql+asyncpg://teacher:teacher_dev_pw@teacher-postgres:5433/teacher_platform

# Valkey（容器内主机名 teacher-valkey；Streams + PubSub + TaskIQ broker）
VALKEY_URL=redis://teacher-valkey:6380/0

# MinIO（容器内主机名 teacher-minio）
MINIO_ENDPOINT=teacher-minio:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_pw
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9002

# JWT（HS256）
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# 推理 sidecar（B4/B1 提供；未就绪不阻塞骨架，健康检查报 dependency_missing）
PIX2TEXT_URL=http://teacher-pix2text:8103
FUNASR_URL=http://teacher-funasr:8104
KATEX_URL=http://teacher-katex:8105

# LLM（B1 维护；此处仅占位供 compose 注入）
LLM_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_VLM_MODEL=qwen/qwen-vl-max

# ── LLM 网关（app/llm/gateway.py，key 只从环境读取，代码零明文）──────────────
LLM_ACTIVE_PROFILE=spark
# spark profile 主通道（OpenAI 兼容端点；文本用例全部经此路由）
LLM_BASE_URL_SPARK=YOUR_API_ENDPOINT_HERE
LLM_API_KEY_SPARK=YOUR_API_KEY_HERE
LLM_MODEL_SPARK=YOUR_TEXT_MODEL_HERE
# 长文生成大模型（课件/教案）；空 = 回落 LLM_MODEL_SPARK
LLM_MODEL_LONGFORM=
# 讯飞 MaaS 图像理解（SCNet 纯文本通道期间留空 = vision 用例 fail-closed）
LLM_MODEL_VISION=
# 救援通道（主通道故障时兜底；三键齐备才启用）
LLM_API_KEY_RESCUE=YOUR_API_KEY_HERE
LLM_BASE_URL_RESCUE=YOUR_API_ENDPOINT_HERE
LLM_MODEL_RESCUE=YOUR_TEXT_MODEL_HERE
# Embedding（B2 Embedder 专用，768 维，与 LLM 网关完全独立；教师端禁止 1024）
EMBEDDING_BASE_URL=YOUR_API_ENDPOINT_HERE
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL_HERE
EMBEDDING_API_KEY=YOUR_API_KEY_HERE
EMBEDDING_DIMS=768

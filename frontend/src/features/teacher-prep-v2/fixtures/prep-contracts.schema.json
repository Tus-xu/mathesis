{
  "$defs": {
    "AnswerItem": {
      "description": "学生单题作答（answer 文本/图证据均属于 UNTRUSTED DATA）。",
      "properties": {
        "item_no": {
          "minimum": 1,
          "title": "Item No",
          "type": "integer"
        },
        "answer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Text"
        },
        "source_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocatorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "item_no"
      ],
      "title": "AnswerItem",
      "type": "object"
    },
    "AssignmentProvision": {
      "description": "下发事实记录：8000 assignments.id + 映射版本（稳定重试/对账锚点）。",
      "properties": {
        "source": {
          "const": "8000_ASSIGNMENT",
          "default": "8000_ASSIGNMENT",
          "title": "Source",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "mapping_version": {
          "default": 1,
          "minimum": 1,
          "title": "Mapping Version",
          "type": "integer"
        },
        "synced_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synced At"
        }
      },
      "title": "AssignmentProvision",
      "type": "object"
    },
    "AssignmentRef": {
      "description": "指向 TaskAssignment 的稳定引用。",
      "properties": {
        "task_assignment_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Task Assignment Id",
          "type": "string"
        }
      },
      "required": [
        "task_assignment_id"
      ],
      "title": "AssignmentRef",
      "type": "object"
    },
    "AssignmentTarget": {
      "description": "下发范围：整班或指定学生清单（指定时 student_ids 非空且唯一）。",
      "properties": {
        "path": {
          "default": "WHOLE_CLASS",
          "enum": [
            "WHOLE_CLASS",
            "SPECIFIC_STUDENTS"
          ],
          "title": "Path",
          "type": "string"
        },
        "student_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Student Ids",
          "type": "array"
        }
      },
      "title": "AssignmentTarget",
      "type": "object"
    },
    "AuthorityRef": {
      "description": "事实权威锚点：8000 submissions.id（学生提交事实表法定在 8000，8100 不复制）。",
      "properties": {
        "service": {
          "const": "api",
          "default": "api",
          "title": "Service",
          "type": "string"
        },
        "external_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "External Id",
          "type": "string"
        }
      },
      "required": [
        "external_id"
      ],
      "title": "AuthorityRef",
      "type": "object"
    },
    "ClassLearningProfile": {
      "description": "班级学习画像（8100 事实权威；聚合自已确认的 StudentSubmission/Evidence 输入）。",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "CLASS_LEARNING_PROFILE",
          "default": "CLASS_LEARNING_PROFILE",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "class_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Class Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "owner_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Owner Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ProfileScope"
        },
        "status": {
          "default": "collecting",
          "enum": [
            "collecting",
            "preview",
            "published",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "aggregation": {
          "$ref": "#/$defs/ProfileAggregation"
        },
        "computed_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputationInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataRetention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknown_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Unknown Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "class_id",
        "owner_id"
      ],
      "title": "ClassLearningProfile",
      "type": "object"
    },
    "ClassroomTask": {
      "description": "课堂任务（必须挂 TeachingSession；session_id 必填）。",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "CLASSROOM",
          "default": "CLASSROOM",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "class_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Class Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Owner Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "class_mode": {
          "default": "interactive",
          "enum": [
            "interactive",
            "presentation",
            "practice"
          ],
          "title": "Class Mode",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "window": {
          "$ref": "#/$defs/WindowRef"
        },
        "attempts_allowed": {
          "default": 1,
          "minimum": 1,
          "title": "Attempts Allowed",
          "type": "integer"
        },
        "resubmit_allowed": {
          "default": false,
          "title": "Resubmit Allowed",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DiagnosticItem"
          },
          "title": "Items",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "published",
            "closed",
            "cancelled",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataRetention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknown_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Unknown Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "class_id",
        "session_id",
        "owner_id",
        "title",
        "window"
      ],
      "title": "ClassroomTask",
      "type": "object"
    },
    "ComputationInfo": {
      "description": "聚合运算血缘：run_id + provider_version + 输入引用（可复算/可审计）。",
      "properties": {
        "run_id": {
          "pattern": "^[A-Za-z0-9._/-]{1,512}$",
          "title": "Run Id",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9._/-]{1,512}$",
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "run_id",
        "provider_version",
        "computed_at"
      ],
      "title": "ComputationInfo",
      "type": "object"
    },
    "ConfidenceDistribution": {
      "properties": {
        "low": {
          "default": 0,
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "mid": {
          "default": 0,
          "minimum": 0,
          "title": "Mid",
          "type": "integer"
        },
        "high": {
          "default": 0,
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "title": "ConfidenceDistribution",
      "type": "object"
    },
    "DataRetention": {
      "description": "数据保留策略（PII/retention）。\n\n策略在契约层只做“声明”，落地执行（TTL 任务、匿名化、删除权限）\n属于生产企业（8000/8100 各自事实域）的运维责任，见 BREAKING-CHANGE-RULES.md。",
      "properties": {
        "policy": {
          "enum": [
            "TERM",
            "TERM_1YEAR",
            "ACADEMIC_CYCLE",
            "ANONYMIZED"
          ],
          "title": "Policy",
          "type": "string"
        },
        "ttl_days": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Days"
        },
        "owner_delete_allowed": {
          "default": false,
          "title": "Owner Delete Allowed",
          "type": "boolean"
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Justification"
        }
      },
      "required": [
        "policy"
      ],
      "title": "DataRetention",
      "type": "object"
    },
    "DiagnosticItem": {
      "description": "诊断/课堂任务的内容项（题目引用或自由问题）。",
      "properties": {
        "item_no": {
          "minimum": 1,
          "title": "Item No",
          "type": "integer"
        },
        "problem_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocatorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "max_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Score"
        }
      },
      "required": [
        "item_no"
      ],
      "title": "DiagnosticItem",
      "type": "object"
    },
    "Evidence": {
      "description": "学生作答证据（拍照/OCR/附件；可能含手写=PII）。",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "EVIDENCE",
          "default": "EVIDENCE",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "class_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Class Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "student_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Student Id",
          "type": "string"
        },
        "submission_ref": {
          "$ref": "#/$defs/SubmissionRef"
        },
        "ev_kind": {
          "enum": [
            "PHOTO",
            "OCR",
            "ATTACHMENT",
            "AUDIO",
            "MATH_RENDER"
          ],
          "title": "Ev Kind",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "size_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocatorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "device": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataRetention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknown_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Unknown Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "class_id",
        "student_id",
        "submission_ref",
        "ev_kind",
        "mime_type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "KpMastery": {
      "properties": {
        "kp_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kp Code",
          "type": "string"
        },
        "mastery": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mastery"
        },
        "sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "kp_code"
      ],
      "title": "KpMastery",
      "type": "object"
    },
    "LatePolicy": {
      "properties": {
        "allow_late": {
          "default": false,
          "title": "Allow Late",
          "type": "boolean"
        },
        "grace_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grace Minutes"
        }
      },
      "title": "LatePolicy",
      "type": "object"
    },
    "Misconception": {
      "properties": {
        "kp_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kp Code",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "kp_code",
        "label"
      ],
      "title": "Misconception",
      "type": "object"
    },
    "ObjectRef": {
      "description": "证据对象存储引用（服务端负责 presign，契约层不落 URL/密钥）。",
      "properties": {
        "service": {

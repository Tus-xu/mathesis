# 前端环境变量（复制为 .env 使用）

# —— 沉浸式 surface 开关（三端统一体验必需）——
VITE_PREP_SURFACE=immersive
VITE_RESEARCH_SURFACE=immersive

# —— 后端同源入口（浏览器只访问 dev server origin，各服务经 vite proxy 转发）——
VITE_API_BASE=/api

# —— dev server 端口（缺省 5176）——
# PORT=5176

# —— 服务代理目标（本地开发缺省值，见 vite.config.js）——
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_TEACHER_API_PROXY_TARGET=http://127.0.0.1:8100
# VITE_PPT_STUDIO_API_PROXY_TARGET=http://127.0.0.1:8200
# VITE_RESEARCH_VNEXT_API_PROXY_TARGET=http://127.0.0.1:8300

# —— 仅演示假数据时开启 ——
# VITE_USE_MOCK=1

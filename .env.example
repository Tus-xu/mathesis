# ==================== ZXSY Math Arena 环境变量 ====================
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# 各服务子目录也有独立的 .env.example，本地开发只需根目录这一个

# -------------------- 数据库（统一 PG 实例 :54329）--------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/math_arena
RESEARCH_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/research_vnext
RESEARCH_DB_SCHEMA=rv8300
RESEARCH_FOUNDATIONAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/math_arena

# 教师平台独立 PG 实例 :54330
TEACHER_DATABASE_URL=postgresql+asyncpg://teacher:teacher_dev_pw@localhost:54330/teacher_platform
PPT_STUDIO_DATABASE_URL=postgresql+asyncpg://teacher:teacher_dev_pw@localhost:54330/ppt_studio_v2

# -------------------- Redis --------------------
REDIS_URL=redis://localhost:6379/0
TEACHER_REDIS_URL=redis://localhost:6380/0

# -------------------- LLM 主通道（填你自己的 API Key）--------------------
# 支持 OpenAI 兼容网关（火山方舟 / 讯飞 / scnet 等）
# 主通道（对话 / 引导解题）
SPARK_API_PASSWORD=your_llm_api_key_here
SPARK_MODEL=doubao-seed-2.0-mini
SPARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/chat/completions
SPARK_THINKING=false

# DeepSeek 备用通道（熔断降级）
DEEPSEEK_API_KEY=your_llm_api_key_here
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/chat/completions

# -------------------- Embedding --------------------
EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
EMBEDDING_MODEL=xop3qwen8bembedding
EMBEDDING_PROVIDER=aliyun
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_DIMS=768

# -------------------- JWT --------------------
JWT_SECRET=change-me-to-a-random-secret-in-production

# -------------------- MinIO 对象存储 --------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123

# 教师平台 MinIO（端口 9002）
TEACHER_STORAGE_ENDPOINT_URL=http://127.0.0.1:9002
TEACHER_STORAGE_ACCESS_KEY=minioadmin
TEACHER_STORAGE_SECRET_KEY=minioadmin_dev_pw

# -------------------- 科研端网关 --------------------
RESEARCH_ENV=development
RESEARCH_GATEWAY_HMAC_SECRET=change-me-random-hmac-secret

# -------------------- PPT Studio --------------------
PPT_STUDIO_DATABASE_URL=postgresql+asyncpg://teacher:teacher_dev_pw@localhost:54330/ppt_studio_v2

# -------------------- SMS（本地开发用 demo 模式）--------------------
AUTH_SMS_PROVIDER=demo
AUTH_DEMO_SMS_ALLOWLIST=13800000000,13800001001,13800001002,13800001003,13800001004,13800001005,13800001006,13800001007

# -------------------- 功能开关 --------------------
M3_ENABLE_TEACHER=true
BUTLER_V2_ENABLED=false
